# Database
DATABASE_URL="postgresql://user:password@localhost:5432/legalq?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Static login (no Google sign-in)
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me-to-a-strong-password"
AUTH_DISPLAY_NAME="Legal Team"

# Google OAuth (optional — only for Gmail/Sheets API, not login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gmail API (inbox read + system send)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_INBOX_EMAIL="legal@prathaminternational.org"

# Outbound emails sent from system mailbox
SYSTEM_EMAIL_FROM="legal@prathaminternational.org"
SYSTEM_EMAIL_FROM_NAME="Pratham Legal"

# Notify legal team when stakeholder replies
LEGAL_TEAM_NOTIFY_EMAIL="pragya@example.org"

# AWS Bedrock (Claude triage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"

# Cron jobs (Vercel cron or external scheduler)
CRON_SECRET="your-cron-secret"
REMINDER_IDLE_DAYS="7"

# Zapier / Google Sheets → LegalQ webhook
ZAPIER_WEBHOOK_SECRET="generate-a-long-random-secret"

# Direct Google Sheets poll (alternative to Zapier)
GOOGLE_SHEETS_ID="spreadsheet-id-from-url"
GOOGLE_SHEETS_RANGE="Sheet1!A:Z"
# Uses GMAIL_REFRESH_TOKEN if GOOGLE_SHEETS_REFRESH_TOKEN is unset
GOOGLE_SHEETS_REFRESH_TOKEN=""
