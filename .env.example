# Database
DATABASE_URL="postgresql://user:password@localhost:5432/legalq?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Simple login — admin + user accounts
# Option A: JSON list (recommended for multiple users)
AUTH_USERS='[{"username":"admin","password":"change-me-admin","role":"admin","name":"Legal Admin"},{"username":"user","password":"change-me-user","role":"user","name":"Legal Viewer"}]'

# Option B: legacy env vars (used when AUTH_USERS is not set)
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me-to-a-strong-password"
AUTH_DISPLAY_NAME="Legal Admin"
AUTH_USER_USERNAME="user"
AUTH_USER_PASSWORD="change-me-user-password"
AUTH_USER_DISPLAY_NAME="Legal Viewer"

# Google Sheet (Apps Script) → LegalQ webhook
SHEET_WEBHOOK_SECRET="generate-a-long-random-secret"

# Gmail outbound (Google Workspace) — sends as legal@prathaminternational.org
GMAIL_SEND_AS="legal@prathaminternational.org"
GMAIL_FROM_NAME="Pratham Legal"

# Option A (recommended): service account with domain-wide delegation
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Or set separately:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Option B: OAuth refresh token for the mailbox (simpler one-off setup)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""

# OpenAI thread matching (optional — falls back to always-create if unset)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
